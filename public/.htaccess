# Rango - Hostinger (LiteSpeed/Apache) ayarları.
# Bu dosya build sırasında dist/ klasörüne kopyalanır.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS'e yönlendir
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # SEO: derleme sırasında üretilen statik sayfalar (dist/_seo, bkz. seo/prerender.ts).
  # Derleme, aşağıdaki işaret satırının yerine üretilen her sayfa için kesin kurallar yazar:
  #   RewriteRule ^$ /_seo/index.html [L]
  #   RewriteRule ^(izmir|izmir/berber|sss|i/ornek-salon)/?$ /_seo/$1.html [L]
  # Adres değişmez; arama motorları ve bağlantı önizlemeleri sayfanın kendi başlığını ve
  # metnini görür, uygulama yüklenince sayfanın yerini alır. Listede olmayan adreslerde
  # aşağıdaki SPA kuralı index.html'i verir. Bu satırı silmeyin.
  # __SEO_STATIC_PAGES__

  # Tek sayfa uygulama (SPA): var olmayan yolları index.html'e yönlendir. Dosya uzantılı
  # adresler hariçtir (ör. artık bulunmayan /assets/eski.js ya da /favicon.ico): onlar uygulama
  # sayfası yerine gerçek bir 404 döner. Uygulamanın kendi adreslerinde nokta yoktur.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://__SUPABASE_HOST__ https://images.pexels.com; font-src 'self' data:; connect-src 'self' https://__SUPABASE_HOST__ wss://__SUPABASE_HOST__; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # HTML sayfaları (index.html ve _seo altındaki statik sayfalar) her zaman güncel gelsin
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # PayTR dönüş sayfası: PayTR bunu kendi ödeme iframe'i içinde açabilir. Yalnızca bu dosya
  # www.paytr.com tarafından çerçevelenebilir; sitenin geri kalanı çerçevelenemez.
  <Files "odeme-sonuc.html">
    Header always unset X-Frame-Options
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://www.paytr.com"
    Header set Cache-Control "no-cache"
  </Files>

  # Vite'ın ürettiği, adında içerik özeti (hash) olan dosyalar hiç değişmez: bir yıl önbellekte kalır.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Adı sabit dosyalar (sektör görselleri, simgeler, paylaşım görseli): içerikleri değişebildiği
  # için bir gün. Bu kural yukarıdakinden SONRA gelmelidir; "sector-barber-2.webp" gibi adlar
  # yukarıdaki desene de uyar ve sondaki kural geçerli olur.
  <FilesMatch "^(sector-[a-z0-9-]+\.webp|og-image\.jpg|apple-touch-icon\.png|icon-(192|512)\.png|favicon\.svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Gizli/yapılandırma dosyalarına erişimi engelle
<FilesMatch "^(\.ht.*|\.env.*|\.git.*|package(-lock)?\.json|.*\.map)$">
  Require all denied
</FilesMatch>
