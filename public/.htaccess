# Rango - Hostinger (LiteSpeed/Apache) ayarları.
# Bu dosya build sırasında dist/ klasörüne kopyalanır.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS'e yönlendir
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # SEO: derleme sırasında üretilen statik sayfalar (dist/_seo, bkz. seo/prerender.ts).
  # Adres değişmez; arama motorları ve bağlantı önizlemeleri sayfanın kendi başlığını ve
  # metnini görür, uygulama yüklenince sayfanın yerini alır. Dosya yoksa bu kurallar atlanır
  # ve aşağıdaki SPA kuralı index.html'i verir.
  RewriteCond %{DOCUMENT_ROOT}/_seo/index.html -f
  RewriteRule ^$ /_seo/index.html [L]

  # Kategori sayfaları: /ara?kategori=kuafor (başka filtre yokken)
  RewriteCond %{QUERY_STRING} ^kategori=([a-z0-9-]+)$
  RewriteCond %{DOCUMENT_ROOT}/_seo/kategori/%1.html -f
  RewriteRule ^ara/?$ /_seo/kategori/%1.html [L]

  # Diğer sayfalar: /kategoriler, /ara, /i/<işletme>, /yasal/<metin>
  RewriteCond %{REQUEST_URI} ^/([a-z0-9]+(?:[/-][a-z0-9]+)*)/?$
  RewriteCond %{DOCUMENT_ROOT}/_seo/%1.html -f
  RewriteRule ^ /_seo/%1.html [L]

  # Tek sayfa uygulama (SPA): var olmayan yolları index.html'e yönlendir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://__SUPABASE_HOST__ https://images.pexels.com; font-src 'self' data:; connect-src 'self' https://__SUPABASE_HOST__ wss://__SUPABASE_HOST__; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # PayTR dönüş sayfası: PayTR bunu kendi ödeme iframe'i içinde açabilir. Yalnızca bu dosya
  # www.paytr.com tarafından çerçevelenebilir; sitenin geri kalanı çerçevelenemez.
  <Files "odeme-sonuc.html">
    Header always unset X-Frame-Options
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://www.paytr.com"
    Header set Cache-Control "no-cache"
  </Files>

  # HTML sayfaları (index.html ve _seo altındaki statik sayfalar) her zaman güncel gelsin,
  # hash'li dosyalar uzun süre önbellekte kalsın
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Sektör görselleri, simgeler ve paylaşım görseli: adları sabit olduğu için bir gün
  <FilesMatch "^(sector_[a-z0-9_]+\.webp|og-image\.jpg|apple-touch-icon\.png|icon-(192|512)\.png|favicon\.svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gizli/yapılandırma dosyalarına erişimi engelle
<FilesMatch "^(\.env.*|\.git.*|package(-lock)?\.json|.*\.map)$">
  Require all denied
</FilesMatch>
