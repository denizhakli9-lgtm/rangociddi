<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rango's app-level privacy manifest, copied into ios/App/App by scripts/ios-prepare.mjs.
  It must match the App Privacy answers in App Store Connect (MOBIL-REHBERI.md, iOS section):
  every type below is linked to the account, used only for app functionality, never for tracking.
  Name, e-mail, phone, business address; customer area (coarse) and the shop pin owners set (precise);
  owners' payout IBAN (payment info) and earnings/commissions (other financial info); bookings and
  payments (purchase history); account id; business photos; booking chat; support messages; reviews,
  notes and favourites; optional gender. Card numbers are entered on PayTR's page and are not collected.
  No required-reason APIs are used by the app's own code; Capacitor and the plugins ship their own manifests.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
